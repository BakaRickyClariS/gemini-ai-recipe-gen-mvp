# Obtain from https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY=your_google_api_key_here

# Gemini AI 設定（可選，預設使用 GOOGLE_API_KEY）
GEMINI_API_KEY=your_gemini_api_key_here

# AI 限制設定
AI_DAILY_LIMIT=3
AI_REQUEST_TIMEOUT=30000

# 主應用後端 URL（庫存 API Proxy 用）
MAIN_BACKEND_URL=https://your-main-backend.com

# Optional
PORT=3000
NODE_ENV=production
