# Obtain from https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY=your_google_api_key_here

# Gemini AI 設定（可選，預設使用 GOOGLE_API_KEY）
GEMINI_API_KEY=your_gemini_api_key_here

# 多 API Key 支援（可選）
# 當主 API Key 的所有模型都達到配額限制時，自動切換到備用 Key
# 支援最多 10 個額外的 API Keys
# GEMINI_API_KEY_1=your_second_api_key
# GEMINI_API_KEY_2=your_third_api_key
# GEMINI_API_KEY_3=your_fourth_api_key
# AI 限制設定
AI_DAILY_LIMIT=3
AI_REQUEST_TIMEOUT=30000

# AI 模型設定（已內建自動 Fallback 機制）
# ┌─────────────────────────────────────────────────────────────────┐
# │ 模型分流策略：同一 API Key 可調用不同模型，各有獨立配額            │
# │ 當主模型達到 429 配額限制時，自動切換到備用模型                    │
# ├─────────────────────────────────────────────────────────────────┤
# │ 功能              │ 主模型 → 備用 1 → 備用 2                      │
# ├─────────────────────────────────────────────────────────────────┤
# │ 食譜生成          │ gemini-2.5-flash → gemini-3-flash → lite     │
# │ 影像/食材辨識     │ gemini-2.5-flash-lite → flash → gemini-3     │
# │ 文字生成          │ gemini-2.5-flash → gemini-3-flash             │
# │ 食譜圖片生成      │ gemini-2.0-flash-exp-image-generation         │
# └─────────────────────────────────────────────────────────────────┘
# 總計每日可用：60+ 次（主模型 20 + 備用模型們各 20）
#
# 模型優先順序配置於 src/services/modelClient.ts

# Cloudinary 設定 (媒體上傳用)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional
PORT=3000
NODE_ENV=production


# DB
DB_USER=fufood
DB_PASSWORD=fufood123456
DB_NAME=fufood
# Docker 內部連接使用的 URL
DATABASE_URL=postgresql://fufood:fufood123456@db:5432/fufood

PGADMIN_DEFAULT_EMAIL=fufood@gmail.com
PGADMIN_DEFAULT_PASSWORD=fufood123456

JWT_SECRET=55667788
JWT_EXPIRE=604800
