{
  "openapi": "3.0.3",
  "info": {
    "title": "Recipe API",
    "version": "2.4.0",
    "description": "AI 食譜生成 API - 支援 Gemini AI 多食譜推薦與 SSE Streaming"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "健康檢查",
        "tags": ["系統"],
        "responses": {
          "200": {
            "description": "API 運行正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "✅ 食譜 API 運行正常" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "系統狀態",
        "tags": ["系統"],
        "responses": {
          "200": {
            "description": "系統狀態資訊",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uptime": { "type": "number", "description": "伺服器運行時間（秒）" },
                    "memory": { "type": "object", "description": "記憶體使用情況" },
                    "pid": { "type": "integer", "description": "程序 ID" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/recipe/suggestions": {
      "get": {
        "summary": "取得預設 Prompt 建議",
        "tags": ["AI 食譜"],
        "responses": {
          "200": {
            "description": "預設 Prompt 建議列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "ok" },
                    "data": {
                      "type": "array",
                      "items": { "type": "string" },
                      "example": ["台灣感性的食物", "晚餐想吃日式", "聖誕節大餐", "想念泰國料理"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/recipe": {
      "post": {
        "summary": "AI 食譜生成（標準回應）",
        "tags": ["AI 食譜"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIRecipeRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "使用者 ID（用於每日查詢限制）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "食譜生成成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIRecipeResponse" }
              }
            }
          },
          "400": { "description": "請求驗證失敗" },
          "429": { "description": "超過每日查詢限制" }
        }
      }
    },
    "/api/v1/ai/recipe/stream": {
      "post": {
        "summary": "AI 食譜生成（SSE Streaming）",
        "description": "使用 Server-Sent Events 即時串流回應，提供更好的使用者體驗",
        "tags": ["AI 食譜"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AIRecipeRequest" }
            }
          }
        },
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "使用者 ID（用於每日查詢限制）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 串流回應",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 事件串流，包含 start、chunk、progress、done、error 事件"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/upload": {
      "post": {
        "summary": "上傳圖片檔案",
        "tags": ["媒體上傳"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "要上傳的圖片檔案" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上傳成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": { "type": "string", "example": "https://res.cloudinary.com/..." },
                        "publicId": { "type": "string", "example": "fufood/..." }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/analyze-image": {
      "post": {
        "summary": "分析食材圖片",
        "tags": ["AI 圖片分析"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "imageUrl": { "type": "string", "format": "uri" }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "圖片分析結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "productName": { "type": "string" },
                        "category": { "type": "string" },
                        "attributes": { "type": "string" },
                        "purchaseQuantity": { "type": "number" },
                        "unit": { "type": "string" },
                        "purchaseDate": { "type": "string" },
                        "expiryDate": { "type": "string" },
                        "lowStockAlert": { "type": "boolean" },
                        "lowStockThreshold": { "type": "number" },
                        "notes": { "type": "string" },
                        "imageUrl": { "type": "string", "nullable": true }
                      }
                    },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/analyze-image/multiple": {
      "post": {
        "summary": "多食材影像分析",
        "tags": ["AI 圖片分析"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageUrl": { "type": "string", "format": "uri" },
                  "cropImages": { "type": "boolean", "default": true },
                  "maxIngredients": { "type": "integer", "default": 10 }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "cropImages": { "type": "boolean", "default": true },
                  "maxIngredients": { "type": "integer", "default": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "多食材分析結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "originalImageUrl": { "type": "string" },
                        "totalCount": { "type": "integer" },
                        "ingredients": {
                          "type": "array",
                          "items": {
                            "allOf": [
                              { "$ref": "#/components/schemas/IngredientRecognitionResult" },
                              { "type": "object", "properties": { "boundingBox": { "type": "array" } } }
                            ]
                          }
                        },
                        "analyzedAt": { "type": "string", "format": "date-time" }
                      }
                    },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "get": {
        "summary": "取得已儲存的食譜列表",
        "tags": ["食譜儲存"],
        "parameters": [
          { "name": "userId", "in": "query", "schema": { "type": "string" } },
          { "name": "X-User-Id", "in": "header", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "食譜列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "recipes": { "type": "array", "items": { "$ref": "#/components/schemas/SavedRecipe" } },
                        "pagination": {
                          "type": "object",
                          "properties": {
                            "total": { "type": "integer" },
                            "limit": { "type": "integer" },
                            "offset": { "type": "integer" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "儲存新食譜",
        "tags": ["食譜儲存"],
        "parameters": [
          { "name": "X-User-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRecipeInput" } } }
        },
        "responses": {
          "201": { "description": "食譜建立成功" }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "取得通知列表",
        "tags": ["推播通知"],
        "parameters": [
          { "name": "X-User-Id", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "通知列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Notification" } },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": { "type": "integer" },
                        "limit": { "type": "integer" },
                        "total": { "type": "integer" }
                      }
                    },
                    "unreadCount": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/token": {
      "post": {
        "summary": "註冊 FCM Token",
        "tags": ["推播通知"],
        "parameters": [
          { "name": "X-User-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "fcmToken": { "type": "string" } },
                "required": ["fcmToken"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "註冊成功" }
        }
      }
    },
    "/api/v1/notifications/settings": {
      "get": {
        "summary": "取得通知設定",
        "tags": ["推播通知"],
        "parameters": [
          { "name": "X-User-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "通知設定",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/NotificationSettings" }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "更新通知設定",
        "tags": ["推播通知"],
        "parameters": [
          { "name": "X-User-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NotificationSettings" } } }
        },
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/api/v1/notifications/send": {
      "post": {
        "summary": "發送推播通知 (手動觸發)",
        "tags": ["推播通知"],
        "parameters": [
          { "name": "X-User-Id", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userIds": { "type": "array", "items": { "type": "string" } },
                  "title": { "type": "string" },
                  "body": { "type": "string" },
                  "type": { "type": "string", "enum": ["inventory", "group", "shopping", "system"] },
                  "action": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string" },
                      "payload": { "type": "object" }
                    }
                  }
                },
                "required": ["userIds", "title", "body", "type"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "發送成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "sent": { "type": "integer" },
                        "failed": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cron/check-expiry": {
      "post": {
        "summary": "檢查過期食材並發送通知 (Cron Job)",
        "tags": ["排程任務"],
        "security": [ { "BearerAuth": [] } ],
        "responses": {
          "200": {
            "description": "檢查完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "expiringItemsCount": { "type": "integer" },
                        "usersNotified": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "未授權 (Invalid Cron Secret)" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      },
      "AIRecipeRequest": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string" },
          "ingredients": { "type": "array", "items": { "type": "string" } },
          "preferences": {
            "type": "object",
            "properties": {
              "dietary": { "type": "array", "items": { "type": "string" } },
              "cuisine": { "type": "string" },
              "difficulty": { "type": "string" },
              "cookingTime": { "type": "string" }
            }
          }
        }
      },
      "AIRecipeResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "ok" },
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "recipes": { "type": "array", "items": { "type": "object" } },
              "generatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "SavedRecipe": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateRecipeInput": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "object" },
          "isFavorite": { "type": "boolean", "default": false }
        }
      },
      "UpdateRecipeInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "object" },
          "isFavorite": { "type": "boolean" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["inventory", "group", "shopping", "system"] },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "isRead": { "type": "boolean" },
          "action": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "payload": { "type": "object" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "notifyPush": { "type": "boolean", "description": "總開關" },
          "notifyExpiry": { "type": "boolean", "description": "過期提醒" },
          "notifyLowStock": { "type": "boolean", "description": "低庫存提醒" },
          "daysBeforeExpiry": { "type": "integer", "description": "過期提醒天數 (預設 3)" },
          "notifyMarketing": { "type": "boolean", "description": "行銷活動" }
        }
      },
      "IngredientRecognitionResult": {
        "type": "object",
        "properties": {
          "productName": { "type": "string" },
          "category": { "type": "string" },
          "attributes": { "type": "string" },
          "purchaseQuantity": { "type": "number" },
          "unit": { "type": "string" },
          "expiryDate": { "type": "string" },
          "imageUrl": { "type": "string" }
        }
      },
      "BoundingBox": {
        "type": "array",
        "items": { "type": "integer" },
        "description": "[ymin, xmin, ymax, xmax]",
        "minItems": 4,
        "maxItems": 4
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
