{
  "openapi": "3.0.3",
  "info": {
    "title": "FuFood AI Recipe API",
    "version": "2.5.0",
    "description": "AI 食譜生成 API - 支援 Gemini AI 多食譜推薦、SSE Streaming、庫存管理、FCM 多裝置推播"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server"
    }
  ],
  "tags": [
    { "name": "系統", "description": "健康檢查與系統狀態" },
    { "name": "認證", "description": "Session 同步與登出" },
    { "name": "AI 食譜", "description": "AI 食譜生成與建議" },
    { "name": "AI 圖片分析", "description": "食材影像辨識" },
    { "name": "媒體上傳", "description": "圖片上傳" },
    { "name": "食譜儲存", "description": "食譜 CRUD 操作" },
    { "name": "庫存管理", "description": "冰箱食材庫存管理" },
    { "name": "推播通知", "description": "FCM 推播與通知中心" },
    { "name": "排程任務", "description": "Cron Job 觸發端點" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "健康檢查",
        "tags": ["系統"],
        "responses": {
          "200": {
            "description": "API 運行正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "✅ 食譜 API 運行正常"
                    },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "系統狀態",
        "tags": ["系統"],
        "responses": {
          "200": {
            "description": "系統狀態資訊",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uptime": {
                      "type": "number",
                      "description": "伺服器運行時間（秒）"
                    },
                    "memory": {
                      "type": "object",
                      "description": "記憶體使用情況"
                    },
                    "pid": { "type": "integer", "description": "程序 ID" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sync-session": {
      "post": {
        "summary": "同步 Session",
        "description": "前端登入後將 Token 同步給 AI 後端，設定 HttpOnly Cookie",
        "tags": ["認證"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": { "type": "string", "description": "JWT Token" },
                  "userId": { "type": "string", "description": "使用者 ID" }
                },
                "required": ["token"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session 同步成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": {
                      "type": "string",
                      "example": "Session synced successfully"
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "缺少 Token" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "登出",
        "description": "清除 AI 後端的 HttpOnly Cookie",
        "tags": ["認證"],
        "responses": {
          "200": {
            "description": "登出成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": {
                      "type": "string",
                      "example": "Logged out successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/recipe/suggestions": {
      "get": {
        "summary": "取得預設 Prompt 建議",
        "tags": ["AI 食譜"],
        "responses": {
          "200": {
            "description": "預設 Prompt 建議列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "ok" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "suggestions": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/recipe": {
      "post": {
        "summary": "AI 食譜生成（標準回應）",
        "tags": ["AI 食譜"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AIRecipeRequest" }
            }
          }
        },
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "使用者 ID（用於每日查詢限制）",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "食譜生成成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AIRecipeResponse" }
              }
            }
          },
          "400": { "description": "請求驗證失敗" },
          "429": { "description": "超過每日查詢限制" }
        }
      }
    },
    "/api/v1/ai/recipe/stream": {
      "post": {
        "summary": "AI 食譜生成（SSE Streaming）",
        "description": "使用 Server-Sent Events 即時串流回應",
        "tags": ["AI 食譜"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AIRecipeRequest" }
            }
          }
        },
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "使用者 ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 串流回應",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 事件串流"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/upload": {
      "post": {
        "summary": "上傳圖片檔案",
        "tags": ["媒體上傳"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上傳成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "url": { "type": "string" },
                        "publicId": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/analyze-image": {
      "post": {
        "summary": "分析食材圖片（單一食材）",
        "tags": ["AI 圖片分析"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "imageUrl": { "type": "string", "format": "uri" }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "圖片分析結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageAnalysisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/analyze-image/multiple": {
      "post": {
        "summary": "多食材影像分析",
        "tags": ["AI 圖片分析"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageUrl": { "type": "string", "format": "uri" },
                  "cropImages": { "type": "boolean", "default": true },
                  "maxIngredients": { "type": "integer", "default": 10 }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "cropImages": { "type": "boolean", "default": true },
                  "maxIngredients": { "type": "integer", "default": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "多食材分析結果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultipleImageAnalysisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "get": {
        "summary": "取得已儲存的食譜列表",
        "tags": ["食譜儲存"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          { "name": "userId", "in": "query", "schema": { "type": "string" } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "食譜列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecipeListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "儲存新食譜",
        "tags": ["食譜儲存"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRecipeInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "食譜建立成功" }
        }
      }
    },
    "/api/v1/recipes/{id}": {
      "get": {
        "summary": "取得單一食譜",
        "tags": ["食譜儲存"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "食譜詳情" },
          "404": { "description": "找不到該食譜" }
        }
      },
      "put": {
        "summary": "更新食譜",
        "tags": ["食譜儲存"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateRecipeInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" },
          "404": { "description": "找不到該食譜" }
        }
      },
      "delete": {
        "summary": "刪除食譜",
        "tags": ["食譜儲存"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "刪除成功" },
          "404": { "description": "找不到該食譜" }
        }
      }
    },
    "/api/v1/refrigerators/{refrigeratorId}/inventory": {
      "get": {
        "summary": "取得庫存列表",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50 }
          },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["fresh", "expiring", "expired"]
            }
          },
          {
            "name": "include",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "包含額外資料，如 stats,summary"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "庫存列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "新增食材",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateInventoryInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "新增成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "format": "uuid" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refrigerators/{refrigeratorId}/inventory/categories": {
      "get": {
        "summary": "取得分類列表",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "分類列表" }
        }
      }
    },
    "/api/v1/refrigerators/{refrigeratorId}/inventory/summary": {
      "get": {
        "summary": "取得庫存摘要",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "庫存摘要統計" }
        }
      }
    },
    "/api/v1/refrigerators/{refrigeratorId}/inventory/settings": {
      "get": {
        "summary": "取得庫存設定",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "庫存設定" }
        }
      },
      "put": {
        "summary": "更新庫存設定（完整覆蓋）",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InventorySettings" }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" }
        }
      },
      "patch": {
        "summary": "更新庫存設定（部分更新）",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InventorySettings" }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/api/v1/refrigerators/{refrigeratorId}/inventory/{id}": {
      "get": {
        "summary": "取得單筆食材",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "食材詳情" },
          "404": { "description": "找不到該食材" }
        }
      },
      "put": {
        "summary": "更新食材",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateInventoryInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" },
          "404": { "description": "找不到該食材" }
        }
      },
      "delete": {
        "summary": "刪除食材",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "刪除成功" },
          "404": { "description": "找不到該食材" }
        }
      }
    },
    "/api/v1/refrigerators/{refrigeratorId}/inventory/{id}/consume": {
      "post": {
        "summary": "消耗食材",
        "tags": ["庫存管理"],
        "parameters": [
          {
            "name": "refrigeratorId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConsumeInventoryInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "消耗成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "remainingQuantity": { "type": "number" },
                        "unit": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "消耗數量超過庫存" },
          "404": { "description": "找不到該食材" }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "取得通知列表",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["stock", "inspiration", "official"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "通知列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/token": {
      "post": {
        "summary": "註冊 FCM Token（多裝置支援）",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fcmToken": {
                    "type": "string",
                    "description": "Firebase Cloud Messaging Token"
                  },
                  "platform": {
                    "type": "string",
                    "enum": ["web", "ios", "android"],
                    "default": "web"
                  }
                },
                "required": ["fcmToken"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "註冊成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": {
                      "type": "string",
                      "example": "Token registered successfully"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "刪除 FCM Token（登出時呼叫）",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fcmToken": { "type": "string" }
                },
                "required": ["fcmToken"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刪除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": {
                      "type": "string",
                      "example": "Token removed successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/batch-read": {
      "post": {
        "summary": "批次標記已讀",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "通知 ID 列表"
                  },
                  "isRead": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否標記為已讀"
                  }
                },
                "required": ["ids"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "updatedCount": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/batch-delete": {
      "post": {
        "summary": "批次刪除通知",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["ids"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "刪除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "deletedCount": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/settings": {
      "get": {
        "summary": "取得通知設定",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "通知設定",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "$ref": "#/components/schemas/NotificationSettings"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "更新通知設定",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NotificationSettings" }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" }
        }
      }
    },
    "/api/v1/notifications/send": {
      "post": {
        "summary": "發送推播通知",
        "description": "支援 userIds 陣列或 groupId 群組廣播",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendNotificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "發送成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "sent": { "type": "integer" },
                        "failed": { "type": "integer" },
                        "details": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/announcements": {
      "post": {
        "summary": "發送官方公告（管理員專用）",
        "tags": ["推播通知"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnnouncementRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "公告發送成功" }
        }
      }
    },
    "/api/v1/admin/announcements/release": {
      "post": {
        "summary": "版本更新公告（CI/CD 觸發）",
        "tags": ["推播通知"],
        "parameters": [
          {
            "name": "X-Deploy-Secret",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": { "type": "string", "example": "1.2.0" },
                  "releaseNotes": { "type": "string" },
                  "forceUpdate": { "type": "boolean", "default": false }
                },
                "required": ["version", "releaseNotes"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "版本公告發送成功" }
        }
      }
    },
    "/api/cron/check-expiry": {
      "post": {
        "summary": "檢查過期食材並發送通知 (Cron Job)",
        "tags": ["排程任務"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "檢查完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "expiringItemsCount": { "type": "integer" },
                        "usersNotified": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "未授權 (Invalid Cron Secret)" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object" }
        }
      },
      "AIRecipeRequest": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string" },
          "ingredients": { "type": "array", "items": { "type": "string" } },
          "preferences": {
            "type": "object",
            "properties": {
              "dietary": { "type": "array", "items": { "type": "string" } },
              "cuisine": { "type": "string" },
              "difficulty": { "type": "string" },
              "cookingTime": { "type": "string" }
            }
          }
        }
      },
      "AIRecipeResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "ok" },
          "data": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "recipes": { "type": "array", "items": { "type": "object" } },
              "generatedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "ImageAnalysisResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "$ref": "#/components/schemas/IngredientRecognitionResult"
          },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "MultipleImageAnalysisResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "originalImageUrl": { "type": "string" },
              "totalCount": { "type": "integer" },
              "ingredients": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/IngredientRecognitionResult"
                }
              },
              "analyzedAt": { "type": "string", "format": "date-time" }
            }
          },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "IngredientRecognitionResult": {
        "type": "object",
        "properties": {
          "productName": { "type": "string" },
          "category": { "type": "string" },
          "attributes": { "type": "array", "items": { "type": "string" } },
          "purchaseQuantity": { "type": "number" },
          "unit": { "type": "string" },
          "expiryDate": { "type": "string" },
          "imageUrl": { "type": "string" }
        }
      },
      "RecipeListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "recipes": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/SavedRecipe" }
              },
              "pagination": {
                "type": "object",
                "properties": {
                  "total": { "type": "integer" },
                  "limit": { "type": "integer" },
                  "offset": { "type": "integer" }
                }
              }
            }
          }
        }
      },
      "SavedRecipe": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "ingredients": { "type": "array", "items": { "type": "object" } },
          "steps": { "type": "array", "items": { "type": "object" } },
          "isFavorite": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateRecipeInput": {
        "type": "object",
        "required": ["name", "ingredients", "steps"],
        "properties": {
          "name": { "type": "string" },
          "ingredients": { "type": "array", "items": { "type": "object" } },
          "steps": { "type": "array", "items": { "type": "object" } },
          "isFavorite": { "type": "boolean", "default": false }
        }
      },
      "UpdateRecipeInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "ingredients": { "type": "array", "items": { "type": "object" } },
          "steps": { "type": "array", "items": { "type": "object" } },
          "isFavorite": { "type": "boolean" }
        }
      },
      "InventoryListResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/InventoryItem" }
              },
              "total": { "type": "integer" },
              "stats": { "type": "object" },
              "summary": { "type": "object" }
            }
          }
        }
      },
      "InventoryItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "expiryDate": { "type": "string", "format": "date" },
          "purchaseDate": { "type": "string", "format": "date" },
          "imageUrl": { "type": "string" },
          "attributes": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["fresh", "expiring", "expired"]
          }
        }
      },
      "CreateInventoryInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "quantity": { "type": "number", "default": 1 },
          "unit": { "type": "string", "default": "份" },
          "expiryDate": { "type": "string", "format": "date" },
          "purchaseDate": { "type": "string", "format": "date" },
          "imageUrl": { "type": "string" },
          "attributes": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" },
          "lowStockAlert": { "type": "boolean" },
          "lowStockThreshold": { "type": "number" }
        }
      },
      "UpdateInventoryInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "expiryDate": { "type": "string", "format": "date" },
          "purchaseDate": { "type": "string", "format": "date" },
          "imageUrl": { "type": "string" },
          "attributes": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      },
      "ConsumeInventoryInput": {
        "type": "object",
        "required": ["quantity", "reasons"],
        "properties": {
          "quantity": { "type": "number", "minimum": 0.01 },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string", "enum": ["usage", "discard"] }
              }
            }
          }
        }
      },
      "InventorySettings": {
        "type": "object",
        "properties": {
          "categoryOrder": { "type": "array", "items": { "type": "string" } },
          "defaultLayout": { "type": "string", "enum": ["grid", "list"] }
        }
      },
      "NotificationListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Notification" }
              },
              "total": { "type": "integer" },
              "unreadCount": { "type": "integer" }
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total": { "type": "integer" }
            }
          },
          "unreadCount": { "type": "integer" }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "category": {
            "type": "string",
            "enum": ["stock", "inspiration", "official"]
          },
          "type": {
            "type": "string",
            "enum": ["inventory", "group", "shopping", "recipe", "system"]
          },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "isRead": { "type": "boolean" },
          "action": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "payload": { "type": "object" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "notifyPush": { "type": "boolean", "description": "總開關" },
          "notifyExpiry": { "type": "boolean", "description": "過期提醒" },
          "notifyLowStock": { "type": "boolean", "description": "低庫存提醒" },
          "daysBeforeExpiry": {
            "type": "integer",
            "description": "過期提醒天數 (1-30)",
            "minimum": 1,
            "maximum": 30
          },
          "notifyMarketing": { "type": "boolean", "description": "行銷活動" }
        }
      },
      "SendNotificationRequest": {
        "type": "object",
        "required": ["title", "body", "type"],
        "properties": {
          "userIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "目標使用者 ID 列表"
          },
          "groupId": {
            "type": "string",
            "description": "或指定群組（冰箱 ID）廣播"
          },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "inventory",
              "group",
              "shopping",
              "recipe",
              "system",
              "expiry"
            ]
          },
          "category": {
            "type": "string",
            "enum": ["stock", "inspiration", "official"]
          },
          "action": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "payload": { "type": "object" }
            }
          }
        }
      },
      "AnnouncementRequest": {
        "type": "object",
        "required": ["title", "message"],
        "properties": {
          "title": {
            "type": "string",
            "example": "🎉 FuFood v1.2.0 更新上線！"
          },
          "message": {
            "type": "string",
            "example": "新功能：AI 智慧食譜推薦、共享購物清單"
          },
          "type": {
            "type": "string",
            "enum": ["announcement", "update", "maintenance"],
            "default": "announcement"
          },
          "pushNotification": { "type": "boolean", "default": true },
          "data": { "type": "object" }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "UserIdHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id"
      }
    }
  }
}
